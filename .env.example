# Optional: copy this file to .env to override the defaults in docker-compose.yml.
# Without a .env file, "docker compose up" uses exactly these values.

DB_NAME=bookstore
DB_USER=bookstore_user
DB_PASSWORD=bookstore_pass

# Port on your computer for the database (DBeaver) and for the web app
DOCKER_DB_PORT=5434
WEB_PORT=8080

# Secret used to sign login sessions - set a long random value on a real server
SECRET_KEY=change-me-in-production

# Only used by setup.ps1 (local PostgreSQL install without Docker)
DB_HOST=localhost
DB_PORT=5432
